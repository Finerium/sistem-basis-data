<a:ModificationDate>1791280968</a:ModificationDate>
<a:Modifier>Ghaisan Khoirul Badruzaman</a:Modifier>
<a:Comment>Pesan untuk anggota beserta status pengirimannya.</a:Comment>
<a:ConstraintName>ck_notifikasi_konteks</a:ConstraintName>
<a:ServerCheckExpression>id_detail IS NULL OR id_reservasi IS NULL</a:ServerCheckExpression>
<a:EndScript>alter table notifikasi add constraint ck_notifikasi_terkirim check (status_kirim &lt;&gt; &#39;TERKIRIM&#39; OR terkirim_pada IS NOT NULL);
create index ix_notifikasi_belum_kirim on notifikasi (dibuat_pada) where status_kirim = &#39;MENUNGGU&#39;;</a:EndScript>
<a:TotalSavingCurrency/>
