<a:Modifier>Ghaisan Khoirul Badruzaman</a:Modifier>
<a:Comment>Pembayaran (boleh cicilan) untuk satu denda.</a:Comment>
<a:ConstraintName>ck_pembayaran_nominal</a:ConstraintName>
<a:ServerCheckExpression>nominal_bayar &gt; 0</a:ServerCheckExpression>
<a:EndScript>alter table pembayaran add constraint ck_pembayaran_batal check ((status_pembayaran = &#39;SAH&#39; AND alasan_batal IS NULL AND waktu_batal IS NULL) OR (status_pembayaran = &#39;BATAL&#39; AND alasan_batal IS NOT NULL AND waktu_batal IS NOT NULL));</a:EndScript>
<a:TotalSavingCurrency/>
