<o:Table Id="o150">
<a:ObjectID>08F5AF92-62CD-461F-BAD7-9DB1A3B8159C</a:ObjectID>
<a:Name>Reservasi</a:Name>
<a:Code>reservasi</a:Code>
<a:CreationDate>1791280445</a:CreationDate>
<a:Creator>Ghaisan Khoirul Badruzaman</a:Creator>
<a:ModificationDate>1791280445</a:ModificationDate>
<a:Modifier>Ghaisan Khoirul Badruzaman</a:Modifier>
<a:Comment>Permintaan anggota untuk sebuah buku, bukan eksemplar tertentu.</a:Comment>
<a:ConstraintName>ck_reservasi_status</a:ConstraintName>
<a:ServerCheckExpression>(status_reservasi = &#39;MENUNGGU&#39; AND id_eksemplar IS NULL AND batas_ambil IS NULL AND id_detail IS NULL) OR (status_reservasi = &#39;SIAP&#39; AND id_eksemplar IS NOT NULL AND batas_ambil IS NOT NULL AND id_detail IS NULL) OR (status_reservasi = &#39;DIPENUHI&#39; AND id_detail IS NOT NULL) OR (status_reservasi IN (&#39;KADALUWARSA&#39;, &#39;DIBATALKAN&#39;) AND id_detail IS NULL)</a:ServerCheckExpression>
<a:EndScript>create unique index uq_reservasi_aktif_per_buku on reservasi (id_anggota, id_buku) where status_reservasi IN (&#39;MENUNGGU&#39;, &#39;SIAP&#39;);
create unique index uq_reservasi_eksemplar_siap on reservasi (id_eksemplar) where status_reservasi = &#39;SIAP&#39;;
create index ix_reservasi_antrean on reservasi (id_buku, waktu_pengajuan) where status_reservasi = &#39;MENUNGGU&#39;;</a:EndScript>
<a:TotalSavingCurrency/>
<c:Columns>
