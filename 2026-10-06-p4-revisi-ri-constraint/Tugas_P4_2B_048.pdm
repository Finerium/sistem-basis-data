<o:Column Id="o146">
<a:ObjectID>6E2DBFD9-35FB-47BD-8C75-188FDBCF0B87</a:ObjectID>
<a:Name>Status Reservasi</a:Name>
<a:Code>status_reservasi</a:Code>
<a:CreationDate>1791279561</a:CreationDate>
<a:Creator>Ghaisan Khoirul Badruzaman</a:Creator>
<a:ModificationDate>1791279561</a:ModificationDate>
<a:Modifier>Ghaisan Khoirul Badruzaman</a:Modifier>
<a:DefaultValue>MENUNGGU</a:DefaultValue>
<a:DataType>VARCHAR(12)</a:DataType>
<a:Length>12</a:Length>
<a:ListOfValues>MENUNGGU	Menunggu eksemplar
SIAP	Eksemplar siap diambil
DIPENUHI	Sudah dipinjam
KADALUWARSA	Lewat batas ambil
DIBATALKAN	Dibatalkan</a:ListOfValues>
<a:ConstraintName>ck_reservasi_status_reservasi</a:ConstraintName>
<a:Column.Mandatory>1</a:Column.Mandatory>
</o:Column>
<o:Column Id="o147">
