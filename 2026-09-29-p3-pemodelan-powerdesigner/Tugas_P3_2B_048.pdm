<o:Table Id="o129">
<a:ObjectID>38F23043-BC0A-49B2-8B9E-FF716DD0C7C8</a:ObjectID>
<a:Name>Detail Peminjaman</a:Name>
<a:Code>detail_peminjaman</a:Code>
<a:CreationDate>1791121445</a:CreationDate>
<a:Creator>Ghaisan Khoirul Badruzaman</a:Creator>
<a:ModificationDate>1791121445</a:ModificationDate>
<a:Modifier>Ghaisan Khoirul Badruzaman</a:Modifier>
<a:Comment>Satu eksemplar di dalam satu transaksi peminjaman.</a:Comment>
<a:ConstraintName>ck_detail_selesai</a:ConstraintName>
<a:ServerCheckExpression>(status_detail = &#39;AKTIF&#39; AND waktu_selesai IS NULL) OR (status_detail &lt;&gt; &#39;AKTIF&#39; AND waktu_selesai IS NOT NULL AND id_petugas IS NOT NULL)</a:ServerCheckExpression>
<a:EndScript>alter table detail_peminjaman add constraint ck_detail_ditutup check (status_detail &lt;&gt; &#39;DITUTUP&#39; OR alasan_penutupan IS NOT NULL);
create unique index uq_detail_eksemplar_aktif on detail_peminjaman (id_eksemplar) where status_detail = &#39;AKTIF&#39;;</a:EndScript>
<a:TotalSavingCurrency/>
<c:Columns>
